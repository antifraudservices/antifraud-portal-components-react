{
  "name": "antifraud-portal-components-react",
  "version": "0.2.2",
  "description": "Reusable React components for neutral antifraud verification and attestation journeys",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": {
    "./dist/conversation-surface.js": "./dist/conversation-surface.web.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./credential-profile-selector": {
      "types": "./dist/credential-profile-selector.d.ts",
      "default": "./dist/credential-profile-selector.js"
    },
    "./identity-evidence-editor": {
      "types": "./dist/identity-evidence-editor.d.ts",
      "default": "./dist/identity-evidence-editor.js"
    },
    "./environment-selector": {
      "types": "./dist/environment-selector.d.ts",
      "default": "./dist/environment-selector.js"
    },
    "./organization-workforce-administration": {
      "types": "./dist/organization-workforce-administration.d.ts",
      "default": "./dist/organization-workforce-administration.js"
    },
    "./conversation-surface": {
      "types": "./dist/conversation-surface.d.ts",
      "browser": "./dist/conversation-surface.web.js",
      "react-native": "./dist/conversation-surface.js",
      "default": "./dist/conversation-surface.web.js"
    },
    "./styles.css": "./dist/styles.css",
    "./professional-qualification-card": {
      "types": "./dist/professional-qualification-card.d.ts",
      "default": "./dist/professional-qualification-card.js"
    },
    "./qualification-evidence-editor": {
      "types": "./dist/qualification-evidence-editor.d.ts",
      "default": "./dist/qualification-evidence-editor.js"
    },
    "./sector-portal-surfaces": {
      "types": "./dist/sector-portal-surfaces.d.ts",
      "default": "./dist/sector-portal-surfaces.js"
    },
    "./verification-journey-panel": {
      "types": "./dist/verification-journey-panel.d.ts",
      "default": "./dist/verification-journey-panel.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/styles.css','dist/styles.css')\"",
    "test": "vitest run --exclude test/organization-workforce-administration.test.tsx",
    "test:legacy:workforce": "vitest run test/organization-workforce-administration.test.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "@kesha-antonov/react-native-chat": "^6.0.1",
    "react": ">=18.3.0",
    "react-dom": ">=18.3.0",
    "react-native": ">=0.82.0",
    "react-native-gesture-handler": ">=3.0.0",
    "react-native-keyboard-controller": ">=1.0.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-safe-area-context": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@kesha-antonov/react-native-chat": { "optional": true },
    "react-native": { "optional": true },
    "react-native-gesture-handler": { "optional": true },
    "react-native-keyboard-controller": { "optional": true },
    "react-native-reanimated": { "optional": true },
    "react-native-safe-area-context": { "optional": true }
  },
  "devDependencies": {
    "@kesha-antonov/react-native-chat": "6.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.19.15",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "jsdom": "^26.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "3.5.0",
    "react-native-keyboard-controller": "1.23.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antifraudservices/antifraud-portal-components-react.git"
  }
}
