{
  "name": "antifraud-portal-components-react",
  "version": "0.2.0",
  "description": "Reusable React components for neutral antifraud verification and attestation journeys",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./credential-profile-selector": {
      "types": "./dist/credential-profile-selector.d.ts",
      "default": "./dist/credential-profile-selector.js"
    },
    "./identity-evidence-editor": {
      "types": "./dist/identity-evidence-editor.d.ts",
      "default": "./dist/identity-evidence-editor.js"
    },
    "./environment-selector": {
      "types": "./dist/environment-selector.d.ts",
      "default": "./dist/environment-selector.js"
    },
    "./organization-workforce-administration": {
      "types": "./dist/organization-workforce-administration.d.ts",
      "default": "./dist/organization-workforce-administration.js"
    },
    "./styles.css": "./dist/styles.css",
    "./professional-qualification-card": {
      "types": "./dist/professional-qualification-card.d.ts",
      "default": "./dist/professional-qualification-card.js"
    },
    "./qualification-evidence-editor": {
      "types": "./dist/qualification-evidence-editor.d.ts",
      "default": "./dist/qualification-evidence-editor.js"
    },
    "./sector-portal-surfaces": {
      "types": "./dist/sector-portal-surfaces.d.ts",
      "default": "./dist/sector-portal-surfaces.js"
    },
    "./verification-journey-panel": {
      "types": "./dist/verification-journey-panel.d.ts",
      "default": "./dist/verification-journey-panel.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "react": ">=18.3.0",
    "react-dom": ">=18.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.19.15",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "jsdom": "^26.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antifraudservices/antifraud-portal-components-react.git"
  }
}
